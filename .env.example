# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database (Prisma) ----
DB_USER=mrs_user
DB_PASSWORD=mrs_password
DB_NAME=movie_reservation_system
DB_PORT=5432
DATABASE_URL=postgresql://mrs_user:mrs_password@localhost:5432/movie_reservation_system?schema=public

# ---- Auth (Stage 2) ----
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=2h
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---- Object storage: MinIO locally, swap for S3/Cloudinary in prod ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minio_admin
STORAGE_SECRET_ACCESS_KEY=minio_password
STORAGE_BUCKET=movie-posters
STORAGE_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password

# ---- Stripe (Stage 7) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
